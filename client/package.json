{
  "name": "@archon/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc && vite build",
    "preview": "vite preview",
    "dev:phosphor-demo": "vite --config vite.phosphor.config.ts",
    "build:phosphor-demo": "tsc --noEmit && vite build --config vite.phosphor.config.ts",
    "typecheck": "tsc --noEmit",
    "test:store": "node --import tsx --test src/stores/appStore.test.ts",
    "test:codex-efforts": "node --conditions development --import tsx --test src/utils/codexEfforts.test.ts",
    "test:retention": "node --import tsx --test src/stores/retentionStats.test.ts",
    "test:late-text": "node --import tsx --test src/ws/lateText.test.ts",
    "test:compacting-notice": "node --import tsx --test src/ws/compactingNotice.test.ts",
    "test:error-routing": "node --conditions development --import tsx --test src/ws/systemErrorRouting.test.ts",
    "test:cluster-activity": "node --import tsx --test src/components/clusterActivity.helpers.test.ts",
    "test:editor-merge": "node --test src/vendor/odysseus-editor/mergeLayers.test.js"
  },
