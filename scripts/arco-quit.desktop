[Desktop Entry]
Type=Application
Name=Quit Arco
GenericName=Stop Arco
Comment=Stop the Arco dev server and workers
# Exec needs scripts/arco on PATH, or replace it with the absolute path of the checkout.
Exec=arco stop
Icon=application-exit
Terminal=false
Categories=Development;Utility;
StartupNotify=false
Keywords=arco;quit;stop;
