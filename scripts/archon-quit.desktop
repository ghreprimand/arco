[Desktop Entry]
Type=Application
Name=Quit Arco
GenericName=Stop Arco
Comment=Stop the Arco dev server and workers
# Exec needs scripts/archon on PATH, or replace it with the absolute path of the checkout.
Exec=archon stop
Icon=application-exit
Terminal=false
Categories=Development;Utility;
StartupNotify=false
Keywords=archon;quit;stop;
