#!/usr/bin/env bash
# Arco launcher — start|stop|restart|status|logs
# Invoked from the system launcher or directly from a shell.

set -euo pipefail

# Default project directory: the checkout this script lives in, resolving
# symlinks so a link on PATH still finds the repository.
_arco_self="${BASH_SOURCE[0]}"
while [ -L "$_arco_self" ]; do
  _arco_link="$(readlink "$_arco_self")"
  case "$_arco_link" in
    /*) _arco_self="$_arco_link" ;;
    *) _arco_self="$(dirname "$_arco_self")/$_arco_link" ;;
  esac
done
ARCO_DIR="${ARCO_DIR:-$(cd "$(dirname "$_arco_self")/.." && pwd -P)}"
ARCO_DIR="$(cd "$ARCO_DIR" && pwd -P)"
unset _arco_self _arco_link
CLIENT_PORT="${ARCO_CLIENT_PORT:-5173}"
SERVER_PORT="${ARCO_SERVER_PORT:-3001}"
URL="http://localhost:${CLIENT_PORT}"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/arco"
PID_FILE="${CACHE_DIR}/arco.pid"
LOG_FILE="${CACHE_DIR}/arco.log"
START_LOCK_DIR="${CACHE_DIR}/start.lock.d"
BROWSER_LOCK_DIR="${CACHE_DIR}/browser.lock.d"
BROWSER_LAST_OPEN="${CACHE_DIR}/browser-last-open"
TRACE_FILE="${CACHE_DIR}/launcher-trace.log"

mkdir -p "$CACHE_DIR"

trace() {
  # Append a timestamped trace line. Separate file so it doesn't compete with
  # the dev-server log, and so we can show exactly what happened on each click.
  printf '%s [pid=%d ppid=%d] %s\n' "$(date -Iseconds)" "$$" "$PPID" "$*" >> "$TRACE_FILE"
}

notify() {
  # Desktop notification if available; otherwise stderr. Never fatal.
  local title="$1"
  local body="${2:-}"
  local urgency="${3:-normal}"
  echo "[arco-launcher] $title${body:+: $body}" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a Arco -u "$urgency" "$title" "$body" 2>/dev/null || true
  fi
}

port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$"
  else
    (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null && { exec 3<&-; return 0; } || return 1
  fi
}

# Find PID listening on a given port. Returns empty if none.
pid_on_port() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltnp 2>/dev/null | awk -v p=":$port" '$4 ~ p {print $0}' | grep -oP 'pid=\K[0-9]+' | head -1 || true
  else
    echo ""
  fi
}

# Walk forward from $1 until we find a port that's free (or some other
# Arco process holds it — those get reaped by the start logic anyway).
# Caps at $1+50 to avoid runaway. Echoes the chosen port on stdout.
find_free_port() {
  local start="$1"
  local port="$start"
  local limit=$((start + 50))
  while [[ "$port" -lt "$limit" ]]; do
    if ! port_in_use "$port"; then
      echo "$port"
      return 0
    fi
    local pid
    pid=$(pid_on_port "$port")
    if [[ -n "$pid" ]] && pid_is_arco "$pid"; then
      # Arco process squatting — start() will reap it. Treat as usable.
      echo "$port"
      return 0
    fi
    port=$((port + 1))
  done
  # Nothing free in 50 ports — give up; caller will surface an error.
  echo "$start"
  return 1
}

# Process facts are kept separate so ownership tests never signal host processes.
process_cwd() { readlink "/proc/$1/cwd" 2>/dev/null || true; }
process_home() {
  [[ -r "/proc/$1/environ" ]] || return 1
  local values configured user_home
  values=$(head -c 65536 "/proc/$1/environ" | tr '\0' '\n')
  configured=$(printf '%s\n' "$values" | sed -n 's/^ARCO_HOME=//p' | head -n 1)
  user_home=$(printf '%s\n' "$values" | sed -n 's/^HOME=//p' | head -n 1)
  if [[ -n "$configured" ]]; then printf '%s' "$configured";
  elif [[ -n "$user_home" ]]; then printf '%s/.arco' "$user_home";
  else return 1; fi
}
process_start_id() {
  local value
  value=$(head -c 4096 "/proc/$1/stat" 2>/dev/null) || return 1
  value=${value##*) }
  set -- $value
  printf '%s' "${20:-}"
}
process_group() { ps -o pgid= -p "$1" 2>/dev/null | tr -d ' '; }

pid_is_arco() {
  local pid="$1" cwd target_home
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  cwd=$(process_cwd "$pid")
  [[ "$cwd" == "$ARCO_DIR" || "$cwd" == "$ARCO_DIR/"* ]] || return 1
  target_home=$(process_home "$pid") || return 1
  [[ "$target_home" == "${ARCO_HOME:-$HOME/.arco}" ]]
}

record_pid() {
  local pid="$1" started
  started=$(process_start_id "$pid") || return 1
  [[ -n "$started" ]] || return 1
  printf '%s\n' "$pid" "$started" "$ARCO_DIR" "${ARCO_HOME:-$HOME/.arco}" > "$PID_FILE.tmp"
  mv "$PID_FILE.tmp" "$PID_FILE"
}

recorded_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid started current
  pid=$(sed -n '1p' "$PID_FILE")
  started=$(sed -n '2p' "$PID_FILE")
  [[ -n "$started" && "$(sed -n '3p' "$PID_FILE")" == "$ARCO_DIR" && "$(sed -n '4p' "$PID_FILE")" == "${ARCO_HOME:-$HOME/.arco}" ]] || return 1
  current=$(process_start_id "$pid") || return 1
  [[ "$current" == "$started" ]] && pid_is_arco "$pid" || return 1
  [[ "$(process_start_id "$pid")" == "$started" ]] || return 1
  printf '%s' "$pid"
}

signal_owned_pid() {
  local pid="$1" signal="${2:-TERM}" started
  started=$(process_start_id "$pid") || return 1
  [[ -n "$started" ]] && pid_is_arco "$pid" || return 1
  [[ "$(process_start_id "$pid")" == "$started" ]] || return 1
  kill "-$signal" "$pid" 2>/dev/null || true
}

# Reap orphaned Arco processes holding our ports. Safe — only kills
# processes whose cwd/cmdline is tied to $ARCO_DIR.
reap_orphans() {
  local reaped=0
  for port in "$CLIENT_PORT" "$SERVER_PORT"; do
    local pid
    pid=$(pid_on_port "$port")
    if [[ -n "$pid" ]] && pid_is_arco "$pid"; then
      signal_owned_pid "$pid" TERM || true
      reaped=1
    fi
  done
  if [[ "$reaped" -eq 1 ]]; then
    # Give them a moment to exit, then escalate if stubborn
    sleep 1
    for port in "$CLIENT_PORT" "$SERVER_PORT"; do
      local pid
      pid=$(pid_on_port "$port")
      if [[ -n "$pid" ]] && pid_is_arco "$pid"; then
        signal_owned_pid "$pid" KILL || true
      fi
    done
    sleep 0.5
  fi
}

is_running() {
  local pid
  pid=$(recorded_pid) || pid=""
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  local client_pid server_pid
  client_pid=$(pid_on_port "$CLIENT_PORT")
  server_pid=$(pid_on_port "$SERVER_PORT")
  [[ -n "$client_pid" && -n "$server_pid" ]] && pid_is_arco "$client_pid" && pid_is_arco "$server_pid"
}

wait_ready() {
  local tries="${1:-60}"
  for _ in $(seq 1 "$tries"); do
    if port_in_use "$CLIENT_PORT" && port_in_use "$SERVER_PORT"; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

open_browser() {
  # 5s rate-limit collapses genuine double-click firings so one click from
  # the application launcher = one new tab. Launch semantics are now
  # "always stop + restart" (see `start`), so any pre-existing Arco tab
  # is orphaned by the server-kill and its old WS will be dead; the Web
  # Locks singleton in the new tab handles any stragglers via the
  # DuplicateTabOverlay.
  local now last
  now=$(date +%s)
  last=$(cat "$BROWSER_LAST_OPEN" 2>/dev/null || echo 0)
  if [[ $((now - last)) -lt 5 ]]; then
    trace "open_browser SKIP (rate-limit)"
    return
  fi
  echo "$now" > "$BROWSER_LAST_OPEN"

  if command -v xdg-open >/dev/null 2>&1; then
    trace "open_browser FIRE xdg-open"
    xdg-open "$URL" >/dev/null 2>&1 &
    disown 2>/dev/null || true
    return
  fi
  for b in firefox chromium google-chrome brave zen-browser zen; do
    if command -v "$b" >/dev/null 2>&1; then
      trace "open_browser FIRE $b"
      "$b" "$URL" >/dev/null 2>&1 &
      disown 2>/dev/null || true
      return
    fi
  done
  notify "Arco started" "Could not find a browser. Visit $URL" "critical"
}

start() {
  trace "start ENTER args=$* argv0=$0 parent_cmd=$(tr '\0' ' ' </proc/$PPID/cmdline 2>/dev/null | cut -c1-120)"

  # mkdir-based lock — atomic on POSIX, no FD inheritance by children.
  # The previous flock approach leaked fd 9 into `npm run dev`, which
  # held the lock until the dev server died — blocking every subsequent
  # launcher click.
  if ! mkdir "$START_LOCK_DIR" 2>/dev/null; then
    # Check if the lock is stale (directory older than 60s with no owner)
    local lock_age
    lock_age=$(( $(date +%s) - $(stat -c %Y "$START_LOCK_DIR" 2>/dev/null || date +%s) ))
    if [[ "$lock_age" -gt 60 ]]; then
      trace "start REAP-STALE-LOCK (age=${lock_age}s)"
      rmdir "$START_LOCK_DIR" 2>/dev/null || true
      mkdir "$START_LOCK_DIR" 2>/dev/null || {
        trace "start SKIP (could not claim reaped lock)"
        return 0
      }
    else
      trace "start SKIP (another start holds lock, age=${lock_age}s)"
      notify "Arco start already in progress"
      return 0
    fi
  fi
  # shellcheck disable=SC2064
  trap "rmdir '$START_LOCK_DIR' 2>/dev/null || true" RETURN

  # Single-instance guarantee: always nuke any existing Arco processes
  # before a fresh boot. Launch always means one clean instance;
  # a session that got killed mid-turn can be resumed via the picker. Simpler UX contract than the previous RUNNING-ALREADY /
  # reap-orphans branching.
  if is_running \
       || port_in_use "$CLIENT_PORT" \
       || port_in_use "$SERVER_PORT"; then
    trace "start NUKE-EXISTING → stop before fresh boot"
    stop
    # Brief settle so the kernel releases ports before we try to bind.
    sleep 1
    # If a non-Arco process is squatting on a port, bump to the next
    # free one rather than refusing. Arco processes still on the port
    # get one more kill attempt (the stop() above should already have
    # taken them out).
    for port_var in CLIENT_PORT SERVER_PORT; do
      local port="${!port_var}"
      if port_in_use "$port"; then
        local pid
        pid=$(pid_on_port "$port")
        if [[ -n "$pid" ]] && ! pid_is_arco "$pid"; then
          local fresh
          fresh=$(find_free_port "$port") || {
            notify "Arco: no free port" "All ports near $port are taken" "critical"
            exit 1
          }
          if [[ "$fresh" != "$port" ]]; then
            notify "Arco: port $port busy" "Using $fresh instead"
            trace "start PORT-BUMP $port_var $port → $fresh (held by non-Arco pid $pid)"
            eval "$port_var=$fresh"
          fi
        else
          [[ -n "$pid" ]] && signal_owned_pid "$pid" KILL || true
        fi
      fi
    done
  fi

  # Recompute URL in case CLIENT_PORT got bumped above.
  URL="http://localhost:${CLIENT_PORT}"

  notify "Starting Arco" "Launching dev server in $ARCO_DIR"
  cd "$ARCO_DIR"
  {
    echo ""
    echo "=== $(date -Iseconds) — arco start (client=$CLIENT_PORT server=$SERVER_PORT) ==="
  } >> "$LOG_FILE"
  # setsid makes the child its own session leader so closing the launcher
  # doesn't cascade signals to npm run dev. Export ports so vite + the
  # node server pick up the (possibly-bumped) values.
  export ARCO_CLIENT_PORT="$CLIENT_PORT"
  export ARCO_PORT="$SERVER_PORT"
  nohup setsid npm run dev >> "$LOG_FILE" 2>&1 &
  record_pid "$!" || true
  if ! wait_ready 60; then
    notify "Arco: start failed" "Did not bind ports within 30s. See $LOG_FILE" "critical"
    exit 1
  fi
  trace "start FRESH-BOOT → open_browser url=$URL"
  notify "Arco ready" "$URL"
  open_browser
}

stop() {
  # Prefer the graceful API shutdown: the server broadcasts a `shutdown`
  # WS message so every connected tab shows the stopped overlay and tries
  # to close itself before the process dies. Since the session-cookie gate
  # (server/src/http/wsAuth.ts) this curl gets a 401 unless the server runs
  # with ARCO_WS_AUTH=off, and the signal fallback below does the work.
  local api_ok=0 server_pid
  server_pid=$(pid_on_port "$SERVER_PORT")
  if [[ -n "$server_pid" ]] && pid_is_arco "$server_pid" && command -v curl >/dev/null 2>&1; then
    if curl -sf -X POST "http://localhost:${SERVER_PORT}/api/shutdown" >/dev/null 2>&1; then
      api_ok=1
      # Give the server its 1.5s client-notify window + a little slack
      sleep 2
    fi
  fi

  # If the API didn't clean everything up (or wasn't available), fall back
  # to signalling the process group directly.
  local pid=""
  pid=$(recorded_pid) || pid=""
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    if [[ "$(process_group "$pid")" == "$pid" ]]; then
      kill -- -"$pid" 2>/dev/null || true
    else
      signal_owned_pid "$pid" TERM || true
    fi
  fi
  reap_orphans
  if [[ -f "$PID_FILE" && "$(sed -n '3p' "$PID_FILE")" == "$ARCO_DIR" && "$(sed -n '4p' "$PID_FILE")" == "${ARCO_HOME:-$HOME/.arco}" ]]; then rm -f "$PID_FILE"; fi
  if [[ "$api_ok" -eq 1 ]]; then
    notify "Arco stopped" "Clients notified via API"
  else
    notify "Arco stopped"
  fi
}

status() {
  if is_running; then
    echo "Arco: RUNNING"
    echo "  URL:    $URL"
    echo "  log:    $LOG_FILE"
    if [[ -f "$PID_FILE" ]]; then
      echo "  PID:    $(head -n 1 "$PID_FILE")"
    fi
  else
    echo "Arco: STOPPED"
  fi
}

logs() {
  if [[ ! -f "$LOG_FILE" ]]; then
    echo "No log at $LOG_FILE yet"
    exit 0
  fi
  tail -n "${2:-100}" -f "$LOG_FILE"
}

case "${1:-start}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)  status ;;
  logs)    logs "$@" ;;
  *)
    cat >&2 <<EOF
Usage: $0 {start|stop|restart|status|logs}

Environment:
  ARCO_DIR           Project directory (default: the checkout containing this script)
  ARCO_CLIENT_PORT   Vite dev server port (default: 5173)
  ARCO_SERVER_PORT   WebSocket server port (default: 3001)
EOF
    exit 1
    ;;
esac
